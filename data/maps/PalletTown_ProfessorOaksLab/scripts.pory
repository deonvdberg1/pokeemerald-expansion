// Pallet Town — Prof. Oak's Lab (Khanto)
// Map: MAP_PALLET_TOWN_PROFESSOR_OAKS_LAB_KHANTO

mapscripts PalletTown_ProfessorOaksLab_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call_if_eq(VAR_TEMP_0, 0, OakLab_EventScript_ReadyOakForIntro)
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE {
        if (var(VAR_TEMP_0) == 0) {
            turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE {
        if (var(VAR_TEMP_0) == 0) {
            call(OakLab_EventScript_IntroScene)
        }
    }
}

script OakLab_EventScript_ReadyOakForIntro {
    setobjectxyperm(LOCALID_OAKS_LAB_KHANTO_PROF_OAK, 6, 9)
    setobjectmovementtype(LOCALID_OAKS_LAB_KHANTO_PROF_OAK, MOVEMENT_TYPE_FACE_UP)
    return
}

// ─────────────────────────────────────────────
// INTRO SCENE — Oak greets you, starter offer
// ─────────────────────────────────────────────

script OakLab_EventScript_IntroScene {
    lockall
    textcolor(NPC_TEXT_COLOR_MALE)
    applymovement(1, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox("Oak: Ah, {PLAYER}!
           I've been expecting you.
           Your mother called from HOENN
           and told me you were coming.")
    msgbox("Oak: I'm PROFESSOR OAK.
           I study POKÉMON here in KANTO.
           Your father is in VIRIDIAN CITY
           waiting for you.")
    msgbox("Oak: But before you head out,
           you can't travel without a
           POKÉMON of your own!")
    msgbox("Oak: I have three POKÉMON here.
           Each one has different strengths.
           Choose the one that feels right!")
    setvar(VAR_TEMP_0, 1)
    releaseall
    end
}

// ─────────────────────────────────────────────
// STARTER SELECTION — Poké Ball scripts
// ─────────────────────────────────────────────

script PalletTown_ProfessorOaksLab_EventScript_BulbasaurBall {
    lock
    faceplayer
    msgbox("It's a POKé BALL with
           BULBASAUR inside.
           A GRASS type.
           Would you like BULBASAUR?")
    multichoice(0, 0, 0, 2, FALSE)
    if (var(VAR_RESULT) == 0) {
        setvar(VAR_TEMP_1, 0)
        setvar(VAR_TEMP_2, SPECIES_BULBASAUR)
        call(OakLab_EventScript_GiveStarter)
    } else {
        msgbox("Take your time, choose wisely!")
        release
        end
    }
}

script PalletTown_ProfessorOaksLab_EventScript_CharmanderBall {
    lock
    faceplayer
    msgbox("It's a POKé BALL with
           CHARMANDER inside.
           A FIRE type.
           Would you like CHARMANDER?")
    multichoice(0, 0, 0, 2, FALSE)
    if (var(VAR_RESULT) == 0) {
        setvar(VAR_TEMP_1, 1)
        setvar(VAR_TEMP_2, SPECIES_CHARMANDER)
        call(OakLab_EventScript_GiveStarter)
    } else {
        msgbox("Take your time, choose wisely!")
        release
        end
    }
}

script PalletTown_ProfessorOaksLab_EventScript_SquirtleBall {
    lock
    faceplayer
    msgbox("It's a POKé BALL with
           SQUIRTLE inside.
           A WATER type.
           Would you like SQUIRTLE?")
    multichoice(0, 0, 0, 2, FALSE)
    if (var(VAR_RESULT) == 0) {
        setvar(VAR_TEMP_1, 2)
        setvar(VAR_TEMP_2, SPECIES_SQUIRTLE)
        call(OakLab_EventScript_GiveStarter)
    } else {
        msgbox("Take your time, choose wisely!")
        release
        end
    }
}

// ─────────────────────────────────────────────
// GIVE STARTER — Give the chosen Pokémon + dex + balls
// ─────────────────────────────────────────────

script OakLab_EventScript_GiveStarter {
    lockall
    textcolor(NPC_TEXT_COLOR_MALE)
    // Give starter at level 5
    givemon(var(VAR_TEMP_2), 5, ITEM_NONE)
    setvar(VAR_STARTER_MON, var(VAR_TEMP_2))
    fadescreen(FADE_TO_BLACK)
    removeobject(2)
    removeobject(3)
    removeobject(4)
    fadescreen(FADE_FROM_BLACK)
    msgbox("Oak: Excellent choice!
           That POKÉMON has been my
           research partner's offspring.
           It's strong and loyal!")
    msgbox("Oak: Now then, you'll need
           this as well.")
    // Give Pokédex
    setflag(FLAG_SYS_POKEDEX_GET)
    msgbox("Oak: That's a POKÉDEX!
           It automatically records data
           on POKÉMON you see and catch.
           I'd like you to complete it
           as you travel across KANTO!")
    // Give Poké Balls
    giveitem(ITEM_POKE_BALL, 5)
    msgbox("Oak: Here are some POKé BALLS.
           You'll need them to catch
           wild POKÉMON.")
    msgbox("Oak: Now head north through
           ROUTE 1 to VIRIDIAN CITY.
           Your father is waiting there.
           And remember - to reach
           MOUNT SILVER, you'll need to
           defeat all eight KANTO GYM
           LEADERS and the LEAGUE!")
    msgbox("Oak: Good luck, {PLAYER}!
           I believe in you!")
    setvar(VAR_TEMP_0, 2)
    releaseall
    end
}
