// Pallet Town — Aunt's House 1F
// Map: MAP_PALLET_TOWN_AUNTS_HOUSE_1F

mapscripts PalletTown_AuntsHouse_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
    }
    MAP_SCRIPT_ON_RESUME {
    }
}

// ─────────────────────────────────────────────
// NPC SCRIPTS
// ─────────────────────────────────────────────

// Aunt — Heals the player, gives advice
script PalletTown_AuntsHouse_1F_EventScript_Aunt {
    lock
    faceplayer
    msgbox("Hello, sweetie!
           Ready for your big adventure?
           Make sure you visit Prof. Oak first —
           he has something important for you.")
    release
    end
}

// ─────────────────────────────────────────────
// BG EVENT SCRIPTS
// ─────────────────────────────────────────────

script PalletTown_AuntsHouse_1F_EventScript_TV {
    lock
    msgbox("There's a show about Pokémon on TV.
           They're battling on some faraway island.")
    release
    end
}
