// Pallet Town — Scripts
// Map: MAP_PALLET_TOWN_KHANTO

mapscripts PalletTown_Khanto_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call_if_eq(VAR_TEMP_5, 1, PalletTown_EventScript_SetTruckArrival)
    }
    MAP_SCRIPT_ON_FRAME_TABLE {
        if (var(VAR_TEMP_5) == 1) {
            call(PalletTown_EventScript_TruckArrivalScene)
        }
    }
    MAP_SCRIPT_ON_RESUME {
    }
}

script PalletTown_EventScript_SetTruckArrival {
    setvar(VAR_TEMP_5, 0)
    return
}

// ─────────────────────────────────────────────
// TRUCK ARRIVAL SCENE
// ─────────────────────────────────────────────

script PalletTown_EventScript_TruckArrivalScene {
    lockall
    msgbox("You arrived in PALLET TOWN!\pThe truck driver waves goodbye and drives off.")
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox("There's PROFESSOR OAK's lab\njust ahead.\lBetter go introduce yourself.")
    setvar(VAR_TEMP_5, 0)
    releaseall
    end
}

// ─────────────────────────────────────────────
// OBJECT EVENT SCRIPTS (NPCs)
// ─────────────────────────────────────────────

script PalletTown_ProfOak {
    lock
    faceplayer
    msgbox("Ah, you must be {PLAYER}!\pYour mother called ahead. I've been expecting you!\pCome see me in my lab just up ahead.")
    msgbox("I'll set you up with a POKEMON!")
    release
    end
}

script PalletTown_Woman {
    lock
    faceplayer
    msgbox("Welcome to Pallet Town!\nIt's a quiet little town, but we love it.")
    release
    end
}

script PalletTown_Man {
    lock
    faceplayer
    msgbox("Prof. Oak's lab is up ahead.\nHe's a world-famous POKEMON researcher!")
    release
    end
}

script PalletTown_Fisherman {
    lock
    faceplayer
    msgbox("If you walk in tall grass,\nwild POKEMON will appear.\lBe sure to have some POKE BALLS handy!")
    release
    end
}

// ─────────────────────────────────────────────
// BG EVENT SCRIPTS (Signs)
// ─────────────────────────────────────────────

script PalletTown_TownSign {
    lock
    faceplayer
    msgbox("PALLET TOWN\lA place of new beginnings.")
    release
    end
}

script PalletTown_OakLabSign {
    lock
    faceplayer
    msgbox("OAK POKEMON RESEARCH LAB\lWhere dreams begin.")
    release
    end
}
