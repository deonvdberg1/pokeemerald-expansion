// Pallet Town — Scripts
// Map: MAP_PALLET_TOWN_KHANTO

mapscripts PalletTown_Khanto_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // Any setup logic when entering Pallet Town
        // e.g. setvar(VAR_TEMP_0, 0) for frame events
    }
    MAP_SCRIPT_ON_RESUME {
        // Runs when returning from interior maps (houses, lab)
    }
}

// ─────────────────────────────────────────────
// OBJECT EVENT SCRIPTS (NPCs)
// ─────────────────────────────────────────────

// Prof. Oak — Greets you on arrival, directs you to his lab
script PalletTown_ProfOak {
    lock
    faceplayer
    msgbox("Ah, you must be {PLAYER}!
           Your mother called ahead.
           She said you'd be arriving from Hoenn.")
    msgbox("I'm PROFESSOR OAK.
           I study POKÉMON here in KANTO.")
    msgbox("Your father mentioned you'd be coming.
           He's in VIRIDIAN CITY - but before you
           head out, you'll need a POKÉMON of your own.")
    msgbox("Come see me in my lab just up ahead.
           I'll set you up with a starter POKÉMON!")
    release
    end
}

// Mom — Heal point, basic tips
script PalletTown_Mom {
    lock
    faceplayer
    msgbox("Hello, dear! 
           Take a rest before you head out.")
    release
    end
}

// Rival — Rival encounter trigger
script PalletTown_Rival {
    lock
    faceplayer
    msgbox("{PLAYER}! 
           You're still here?
           I'm going to be the very best,
           you know!")
    release
    end
}

// Generic town NPCs
script PalletTown_Woman {
    lock
    faceplayer
    msgbox("Welcome to Pallet Town!
           It's a quiet little town,
           but we love it.")
    release
    end
}

script PalletTown_Man {
    lock
    faceplayer
    msgbox("Prof. Oak's lab is up ahead.
           He's a world-famous Pokémon researcher!")
    release
    end
}

script PalletTown_Fisherman {
    lock
    faceplayer
    msgbox("If you walk in tall grass,
           wild Pokémon will appear.
           Be sure to have some Pokéballs handy!")
    release
    end
}

// ─────────────────────────────────────────────
// BG EVENT SCRIPTS (Signs, etc.)
// ─────────────────────────────────────────────

script PalletTown_TownSign {
    lock
    faceplayer
    msgbox("PALLET TOWN\lA place of new beginnings.")
    release
    end
}

script PalletTown_OakLabSign {
    lock
    faceplayer
    msgbox("OAK POKÉMON RESEARCH LAB\lWhere dreams begin.")
    release
    end
}
