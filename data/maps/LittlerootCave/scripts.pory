// Littleroot Cave — Scripts
mapscripts LittlerootCave_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // Remove Bagon object if already caught/defeated
        goto_if(FLAG_TEMP_7, LittlerootCave_EventScript_HideBagon)
    }
    MAP_SCRIPT_ON_RESUME {
        // Resume logic
    }
}

// Hide Bagon from the map
script LittlerootCave_EventScript_HideBagon {
    setflag(FLAG_TEMP_7)
    end
}

// Bagon encounter script
script LittlerootCave_EventScript_Bagon {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_BAGON, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setwildbattle(SPECIES_BAGON, 30)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    dowildbattle
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    goto_if_eq(VAR_RESULT, B_OUTCOME_WON, LittlerootCave_EventScript_DefeatedBagon)
    goto_if_eq(VAR_RESULT, B_OUTCOME_RAN, LittlerootCave_EventScript_RanFromBagon)
    goto_if_eq(VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, LittlerootCave_EventScript_RanFromBagon)
    setflag(FLAG_TEMP_7)
    release
    end
}

script LittlerootCave_EventScript_DefeatedBagon {
    setflag(FLAG_TEMP_7)
    goto(Common_EventScript_RemoveStaticPokemon)
    end
}

script LittlerootCave_EventScript_RanFromBagon {
    setvar(VAR_0x8004, SPECIES_BAGON)
    goto(Common_EventScript_LegendaryFlewAway)
    end
}
