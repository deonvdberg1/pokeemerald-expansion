// Pallet Town — Rival's House
// Map: MAP_PALLET_TOWN_RIVALS_HOUSE

mapscripts PalletTown_RivalsHouse_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
    }
    MAP_SCRIPT_ON_RESUME {
    }
}

// ─────────────────────────────────────────────
// NPC SCRIPTS
// ─────────────────────────────────────────────

// Daisy — Rival's older sister
script PalletTown_RivalsHouse_EventScript_Daisy {
    lock
    faceplayer
    msgbox("Hi, {PLAYER}!
           My little brother is at
           Prof. Oak's lab right now.
           He's been talking about becoming
           a Pokémon Trainer all morning!
           You should head over there too.")
    release
    end
}

// Town Map — Give Map on pickup
script PalletTown_RivalsHouse_EventScript_TownMap {
    lock
    faceplayer
    msgbox("It's the Town Map!
           This will help you find
           your way around the region.")
    giveitem(ITEM_TOWN_MAP)
    release
    end
}

// ─────────────────────────────────────────────
// BG EVENT SCRIPTS
// ─────────────────────────────────────────────

script PalletTown_RivalsHouse_EventScript_Bookshelf {
    lock
    msgbox("Books about Pokémon fill the shelves.
           There are notes scribbled in the margins.")
    release
    end
}

script PalletTown_RivalsHouse_EventScript_Picture {
    lock
    msgbox("A family photo on the wall.
           It's the rival's family.")
    release
    end
}
